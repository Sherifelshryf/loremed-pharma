# Loremed Pharma — Apache config for the static export (cPanel / shared hosting).
# Ignored by the Vercel build, which sets these headers in next.config.mjs instead.

# Custom 404 page
ErrorDocument 404 /404.html

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# One canonical host. Every canonical tag, the sitemap and robots.txt name the
# bare domain, so www has to end up there too — otherwise the site is reachable
# at two addresses that each declare the other to be the real one, and the
# ranking signals are split between them. Harmless if www never resolves: the
# rule simply never fires.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Build assets carry a content hash, so they can be cached indefinitely.
# HTML must never be cached or visitors keep seeing the previous deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|avif)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Equivalent of the headers set in next.config.mjs for the server build.
# The Content-Security-Policy values are hand-mirrored from the `CSP` and
# `ADMIN_CSP` constants there (this file has no build step to generate them
# from) — keep all four in sync.
#
# Both policies live here, chosen by request path, rather than the admin one
# sitting in public/admin/.htaccess and overriding this file for that
# directory. That was the first attempt and it half-worked: this host runs
# LiteSpeed, not Apache, and it applied the child's headers to
# /admin/config.yml while /admin/ itself and the editor bundle kept the
# policy below. The editor then loaded, looked fine, and failed to sign in
# with "Failed to fetch" — connect-src 'self' blocking api.github.com.
#
# SetEnvIf plus `env=` is the portable way to do this. <If> blocks are Apache
# 2.4 syntax that LiteSpeed does not reliably honour in .htaccess, and after
# the above there is no appetite for relying on that.
SetEnvIf Request_URI "^/admin(/|$)" LOREMED_ADMIN

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # --- the public site ------------------------------------------------------
  Header set X-Frame-Options "SAMEORIGIN" env=!LOREMED_ADMIN
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://maps.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" env=!LOREMED_ADMIN

  # --- /admin, the CMS ------------------------------------------------------
  # Wider than the policy above, and only on this path. connect-src reaches
  # api.github.com because that is where the editor reads and writes content;
  # script-src allows 'unsafe-eval' and blob: because the bundled editor needs
  # them to boot; font-src allows jsdelivr because the editor's icon font comes
  # from there and without it every button reads "delete" or "add" in words.
  # Acceptable on one page reachable only with a GitHub token; not acceptable
  # site-wide, which is the whole reason for splitting them.
  Header set X-Frame-Options "DENY" env=LOREMED_ADMIN
  Header set X-Robots-Tag "noindex, nofollow" env=LOREMED_ADMIN
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.githubusercontent.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' blob: data: https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" env=LOREMED_ADMIN
</IfModule>
