# Apache/LiteSpeed config for /admin only.
#
# No headers here. They used to live in this file — the relaxed CSP the editor
# needs, plus X-Frame-Options and X-Robots-Tag — on the assumption that a
# nested .htaccess overrides its parent for that directory. On this host it
# only half did: LiteSpeed applied these headers to /admin/config.yml while
# /admin/ itself and the editor bundle kept the site-wide policy, whose
# connect-src 'self' blocks api.github.com. The editor loaded, looked fine, and
# failed to sign in with "Failed to fetch".
#
# Both policies now live in public/.htaccess, selected by request path with
# SetEnvIf. One file, one set of rules, no dependence on merge order.
#
# What is left here is caching, which does work per-directory and has no
# equivalent conflict.

# The 2 MB editor bundle changes only when the version in package.json does, so
# it keeps the year-long cache the parent gives hashed assets. index.html and
# config.yml must not be cached, or an editor keeps loading the previous form
# after the schema changes.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(html|yml)$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>
